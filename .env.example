# Leave empty to run in deterministic rule-based mode (no model calls).
ANTHROPIC_API_KEY=

# Agent 3: Safety Guard & Matcher
ANTHROPIC_MODEL_MATCHER=claude-opus-5-5
# Agents 1 and 2: Data Structurer, Geographic Router
ANTHROPIC_MODEL_FAST=claude-sonnet-5-5
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=4096

# Host default. docker compose overrides this to point at the "db" service.
DATABASE_URL=postgresql+asyncpg://ghost:ghost@localhost:5432/ghost_commuter

CHROMA_PATH=./.chroma
# auto = MiniLM if it can be loaded, else offline hashing embedder | minilm | hash
EMBEDDING_BACKEND=auto

CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=30
LOG_LEVEL=INFO
APP_TIMEZONE=Europe/London
